root = true

[*]
charset = utf-8
insert_final_newline = true

# Android Studio's Reformat Code reads these, so it keeps the project's style instead of wrapping at 100 columns.
[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 160
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
